{
  "name": "@vuqs/core",
  "type": "module",
  "version": "0.0.0",
  "description": "Type-safe query state for Vue 3 with composable codecs and URL sync.",
  "author": "João Pedro Antunes Silva <hi@joaopedroas.com>",
  "license": "MIT",
  "homepage": "https://JoaoPedroAS51.github.io/vuqs",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoaoPedroAS51/vuqs.git"
  },
  "keywords": [
    "vue",
    "query",
    "state",
    "url",
    "router",
    "type-safe",
    "composable"
  ],
  "sideEffects": [
    "./dist/debug.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./debug": {
      "types": "./dist/debug.d.mts",
      "import": "./dist/debug.mjs"
    },
    "./debug/console": {
      "types": "./dist/debug/console.d.mts",
      "import": "./dist/debug/console.mjs"
    },
    "./debug-protocol": {
      "types": "./dist/debug-protocol.d.mts",
      "import": "./dist/debug-protocol.mjs"
    },
    "./adapters/vue-router": {
      "types": "./dist/adapters/vue-router.d.mts",
      "import": "./dist/adapters/vue-router.mjs"
    },
    "./adapters/testing": {
      "types": "./dist/adapters/testing.d.mts",
      "import": "./dist/adapters/testing.mjs"
    },
    "./adapters/browser-history": {
      "types": "./dist/adapters/browser-history.d.mts",
      "import": "./dist/adapters/browser-history.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs"
    },
    "./modules": {
      "types": "./dist/modules/index.d.mts",
      "import": "./dist/modules/index.mjs"
    },
    "./shared": {
      "types": "./dist/shared/index.d.mts",
      "import": "./dist/shared/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:types": "vitest run --project types --typecheck.only",
    "test:coverage": "vitest run --coverage",
    "test:perf": "vitest bench test/perf",
    "test:dist": "node test/package/dist.mjs",
    "test:types:dist": "tsc -p test/package/tsconfig.json",
    "test:package": "turbo run test:dist test:types:dist --filter=@vuqs/core",
    "typecheck": "tsc --noEmit",
    "typecheck:fixtures": "vue-tsc --noEmit -p test/fixtures/browser/tsconfig.json",
    "prepublishOnly": "cp ../../README.md ./README.md && pnpm build",
    "postpublish": "rm -f ./README.md"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
