{
  "name": "@vuqs/nuxt",
  "type": "module",
  "version": "0.0.0",
  "description": "Nuxt Module for vuqs",
  "author": "João Pedro Antunes Silva <hi@joaopedroas.com>",
  "license": "MIT",
  "homepage": "https://JoaoPedroAS51.github.io/vuqs/nuxt/getting-started",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoaoPedroAS51/vuqs.git",
    "directory": "packages/nuxt"
  },
  "keywords": [
    "nuxt",
    "vue",
    "query",
    "state",
    "url",
    "router",
    "type-safe",
    "composable"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "module": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "build": "nuxt-module-build prepare && nuxt-module-build build",
    "dev": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "prepare:fixtures": "nuxt prepare test/fixtures/basic && nuxt prepare test/fixtures/no-pages",
    "test": "pnpm prepare:fixtures && vitest run",
    "test:run": "pnpm test",
    "test:types": "pnpm prepare:fixtures && vue-tsc --build test/fixtures/basic/tsconfig.json test/fixtures/no-pages/tsconfig.json",
    "typecheck": "nuxt-module-build prepare && vue-tsc --noEmit && pnpm test:types",
    "prepublishOnly": "nuxt-module-build prepare && nuxt-module-build build"
  },
  "dependencies": {
    "@nuxt/kit": "catalog:",
    "@vuqs/core": "workspace:*",
    "defu": "catalog:"
  },
  "devDependencies": {
    "@nuxt/module-builder": "catalog:",
    "@nuxt/schema": "catalog:",
    "@nuxt/test-utils": "catalog:",
    "@types/node": "catalog:",
    "nuxt": "catalog:",
    "playwright-core": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
