{
  "name": "vuqs-monorepo",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "build": "turbo run build --filter='./packages/*'",
    "dev": "turbo run dev --filter=@vuqs/core --filter=@vuqs/playground",
    "dev:prepare": "turbo run dev:prepare --filter='./packages/*'",
    "test": "turbo run test --filter='./packages/*'",
    "test:watch": "turbo run test:watch --filter='./packages/*'",
    "test:unit": "turbo run test:unit --filter='./packages/*'",
    "test:integration": "turbo run test:integration --filter='./packages/*'",
    "test:e2e": "turbo run test:e2e --filter='./packages/*'",
    "test:types": "turbo run test:types --filter='./packages/*'",
    "test:coverage": "turbo run test:coverage --filter='./packages/*'",
    "test:perf": "turbo run test:perf --filter=@vuqs/core",
    "test:package": "turbo run test:dist test:types:dist --filter=@vuqs/core",
    "typecheck": "turbo run typecheck --filter='./packages/*'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "playground:build": "turbo run build --filter=@vuqs/playground",
    "docs:dev": "turbo run dev --filter=@vuqs/docs",
    "docs:build": "turbo run build --filter=@vuqs/docs",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
